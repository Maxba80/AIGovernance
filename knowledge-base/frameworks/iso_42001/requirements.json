  {
   "id": "ISO42001-8.1",
   "clause": "8.1",
   "title": "Operational planning and control",
   "summary_paraphrased": "Plan, implement and control processes, including outsourced ones and changes.",
   "citation": "ISO/IEC 42001:2023, clause 8.1"
  },
  {
   "id": "ISO42001-8.2",
   "clause": "8.2",
   "title": "AI risk assessment",
   "summary_paraphrased": "Perform risk assessments at planned intervals or on significant change; retain results.",
   "citation": "ISO/IEC 42001:2023, clause 8.2"
  },
  {
   "id": "ISO42001-8.3",
   "clause": "8.3",
   "title": "AI risk treatment",
