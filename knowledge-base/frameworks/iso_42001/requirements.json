   "id": "ISO42001-4.1",
   "clause": "4.1",
   "title": "Understanding the organization and its context",
   "summary_paraphrased": "Determine external and internal issues, the organisation's AI roles and whether climate change is a relevant issue.",
   "citation": "ISO/IEC 42001:2023, clause 4.1"
  },
  {
   "id": "ISO42001-4.2",
   "clause": "4.2",
   "title": "Understanding the needs and expectations of interested parties",
   "summary_paraphrased": "Identify interested parties and which of their requirements the AIMS addresses.",
   "citation": "ISO/IEC 42001:2023, clause 4.2"
  },
  {
   "id": "ISO42001-4.3",
   "clause": "4.3",
   "title": "Determining the scope of the AI management system",
   "summary_paraphrased": "Define and document the boundaries and applicability of the AIMS.",
   "citation": "ISO/IEC 42001:2023, clause 4.3"
  },
  {
   "id": "ISO42001-4.4",
   "clause": "4.4",
   "title": "AI management system",
   "summary_paraphrased": "Establish, implement, maintain and continually improve the AIMS.",
   "citation": "ISO/IEC 42001:2023, clause 4.4"
  },
  {
   "id": "ISO42001-5.1",
   "clause": "5.1",
   "title": "Leadership and commitment",
   "summary_paraphrased": "Top management demonstrates leadership: policy, objectives, resources, integration into business processes.",
   "citation": "ISO/IEC 42001:2023, clause 5.1"
  },
  {
   "id": "ISO42001-5.2",
   "clause": "5.2",
   "title": "AI policy",
   "summary_paraphrased": "Establish a documented AI policy with commitments to requirements and continual improvement.",
   "citation": "ISO/IEC 42001:2023, clause 5.2"
  },
  {
   "id": "ISO42001-5.3",
   "clause": "5.3",
   "title": "Roles, responsibilities and authorities",
   "summary_paraphrased": "Assign and communicate responsibilities and authorities for the AIMS.",
   "citation": "ISO/IEC 42001:2023, clause 5.3"
  },
  {
   "id": "ISO42001-6.1.1",
   "clause": "6.1.1",
   "title": "Actions to address risks and opportunities — General",
   "summary_paraphrased": "Plan actions for risks and opportunities; define AI risk criteria.",
   "citation": "ISO/IEC 42001:2023, clause 6.1.1"
  },
  {
   "id": "ISO42001-6.1.2",
   "clause": "6.1.2",
   "title": "AI risk assessment",
   "summary_paraphrased": "Define and apply a repeatable AI risk assessment process: identify, analyse, evaluate.",
   "citation": "ISO/IEC 42001:2023, clause 6.1.2"
  },
  {
   "id": "ISO42001-6.1.3",
   "clause": "6.1.3",
   "title": "AI risk treatment",
   "summary_paraphrased": "Select treatment options, determine controls, compare with Annex A, produce the Statement of Applicability and treatment plan.",
   "citation": "ISO/IEC 42001:2023, clause 6.1.3"
  },
  {
   "id": "ISO42001-6.1.4",
   "clause": "6.1.4",
   "title": "AI system impact assessment",
   "summary_paraphrased": "Assess consequences of AI systems for individuals, groups and societies; document results.",
   "citation": "ISO/IEC 42001:2023, clause 6.1.4"
  },
  {
   "id": "ISO42001-6.2",
   "clause": "6.2",
   "title": "AI objectives and planning to achieve them",
   "summary_paraphrased": "Set measurable AI objectives and plans to achieve them.",
   "citation": "ISO/IEC 42001:2023, clause 6.2"
  },
  {
   "id": "ISO42001-6.3",
   "clause": "6.3",
   "title": "Planning of changes",
   "summary_paraphrased": "Carry out changes to the AIMS in a planned manner.",
   "citation": "ISO/IEC 42001:2023, clause 6.3"
  },
  {
