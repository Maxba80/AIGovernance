# Copy to .env and fill in. Never commit .env.

# --- Web application
APP_PORT=3000

# --- Database
POSTGRES_USER=aigov
POSTGRES_DB=aigov
POSTGRES_PASSWORD=change-me-database-password

# --- Security
# Signs sessions and encrypts stored API keys. Generate with:  openssl rand -hex 32
# Changing it later makes stored API keys unreadable (they must be re-entered in Settings).
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- The single user account, created on first start
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=change-me-at-least-10-characters

# --- Local models
# Ollama on the host machine (default). With the bundled container
# (docker compose --profile local-llm up) use http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PORT=11434

# --- Limits
MAX_UPLOAD_MB=100
TOKEN_TTL_HOURS=12

# Cloud API keys (Anthropic, OpenAI, Gemini, Azure OpenAI) are NOT set here:
# add them in the app under Settings > AI providers. They are stored encrypted.
