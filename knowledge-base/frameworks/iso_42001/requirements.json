   "clause": "9.1",
   "title": "Monitoring, measurement, analysis and evaluation",
   "summary_paraphrased": "Determine what is monitored and measured, methods, timing; evaluate AIMS performance.",
   "citation": "ISO/IEC 42001:2023, clause 9.1"
